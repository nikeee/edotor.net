{
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": true,

    "target": "es2025",
    "useDefineForClassFields": true,
    "lib": ["es2025", "DOM", "DOM.Iterable", "esnext.TypedArrays"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "types": [
      "node",
      "bootstrap",
      "pako",
      "react",
      "react-dom",
    ],

    "allowSyntheticDefaultImports": true,

    "jsx": "react-jsx",
    "strict": true,

    "removeComments": true,
    "declaration": false,
    "sourceMap": true
  }
}
