  "dependencies": {
    "@viz-js/viz": "^3.31.0",
    "bootstrap": "^5.3.8",
    "dot-language-support": "^4.4.1",
    "monaco-editor": "^0.57.0",
    "pako": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-spinners": "^0.17.1",
    "react-split-pane": "^3.2.0",
    "svg-pan-zoom": "3.6.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxc-transform-react": "^0.152.0",
    "typescript": "^7.0.2",
    "vite-plugin-ejs": "^2.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plus": "1.0.0",
    "vscode-languageserver-types": "^3.18.4"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "download"
    }
  }
}
