{
  "name": "edotor.net",
  "version": "2.9.1",
  "private": true,
  "description": "Online Graphviz fiddle with language support",
  "license": "MIT",
  "author": "Niklas Mollenhauer",
  "type": "module",
  "scripts": {
    "test": "tsc",
    "build": "vp build",
    "ci": "vp lint --type-aware --type-check --deny-warnings -f github",
